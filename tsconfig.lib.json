{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.lib.tsbuildinfo",
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rewriteRelativeImportExtensions": true,
    "rootDir": "./src",
    "outDir": "./dist/types"
  },
  "include": ["src/components", "src/engine", "src/data", "src/modal", "src/logic"],
  "exclude": ["src/data/node-shim.d.ts", "src/**/*.test.ts", "src/**/*.test.tsx", "src/engine/test-models.ts", "src/modal/engine/test-random.ts", "src/components/golden"]
}
