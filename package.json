{
  "name": "causal-atlas",
  "version": "0.23.0",
  "description": "Interactive structural causal models and a dataset of philosophical causation and decision cases.",
  "license": "MIT AND CC-BY-4.0",
  "author": "洪偉 (Wei Hung)",
  "type": "module",
  "files": [
    "dist",
    "LICENSE",
    "LICENSE-DATA",
    "CITATION.cff"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/components/index.d.ts",
      "import": "./dist/index.js"
    },
    "./engine": {
      "types": "./dist/types/engine/index.d.ts",
      "import": "./dist/engine.js"
    },
    "./data": {
      "types": "./dist/types/data/index.d.ts",
      "import": "./dist/data.js"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "build": "tsc -b && vite build",
    "build:lib": "vite build -c vite.lib.config.ts && tsc -p tsconfig.lib.json && node scripts/fix-dts.mjs dist/types",
    "lint": "oxlint",
    "preview": "vite preview",
    "prepack": "pnpm build:lib"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "katex": "^0.19.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "oxlint": "^1.93.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.21.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wayne930242/causal-atlas.git"
  },
  "homepage": "https://wayneh.tw/causal/"
}
