{
  "name": "causal-atlas",
  "version": "0.24.0",
  "description": "Interactive structural causal models and a dataset of philosophical causation and decision cases.",
  "license": "MIT AND CC-BY-4.0",
  "author": "洪偉 (Wei Hung)",
  "type": "module",
  "files": [
    "dist",
    "LICENSE",
    "LICENSE-DATA",
    "CITATION.cff"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/components/index.d.ts",
      "import": "./dist/index.js"
    },
    "./playground": {
      "types": "./dist/types/components/entries/playground.d.ts",
      "import": "./dist/playground.js"
    },
    "./probability": {
      "types": "./dist/types/components/entries/probability.d.ts",
      "import": "./dist/probability.js"
    },
    "./identify": {
      "types": "./dist/types/components/entries/identify.d.ts",
      "import": "./dist/identify.js"
    },
    "./lanes": {
      "types": "./dist/types/components/entries/lanes.d.ts",
      "import": "./dist/lanes.js"
    },
    "./extension": {
      "types": "./dist/types/components/entries/extension.d.ts",
      "import": "./dist/extension.js"
    },
    "./case": {
      "types": "./dist/types/components/entries/case.d.ts",
      "import": "./dist/case.js"
    },
    "./editor": {
      "types": "./dist/types/components/entries/editor.d.ts",
      "import": "./dist/editor.js"
    },
    "./cite": {
      "types": "./dist/types/components/entries/cite.d.ts",
      "import": "./dist/cite.js"
    },
    "./supplement": {
      "types": "./dist/types/components/entries/supplement.d.ts",
      "import": "./dist/supplement.js"
    },
    "./i18n": {
      "types": "./dist/types/components/entries/i18n.d.ts",
      "import": "./dist/i18n.js"
    },
    "./engine": {
      "types": "./dist/types/engine/index.d.ts",
      "import": "./dist/engine.js"
    },
    "./data": {
      "types": "./dist/types/data/index.d.ts",
      "import": "./dist/data.js"
    },
    "./style.css": "./dist/style.css"
  },
  "imports": {
    "#case-preload": {
      "node": "./dist/case-preload.node.js",
      "default": "./dist/case-preload.browser.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "build": "tsc -b && vite build",
    "build:lib": "vite build -c vite.lib.config.ts && tsc -p tsconfig.lib.json && node scripts/fix-dts.mjs dist/types && pnpm check:dist",
    "check:dist": "node scripts/check-size.mjs && node scripts/check-dist-ssr.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "prepack": "pnpm build:lib"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "katex": "^0.19.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "oxlint": "^1.93.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.21.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wayne930242/causal-atlas.git"
  },
  "homepage": "https://wayneh.tw/causal/"
}
