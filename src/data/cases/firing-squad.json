{
  "id": "firing-squad",
  "title": { "zh": "行刑隊", "en": "Firing squad" },
  "family": "actual",
  "story_zh": "法院下令處決，隊長於是發令，兩名槍手 A 和 B 同時開槍，囚犯死亡。我們知道囚犯死了；如果 A 當時沒有開槍，囚犯會不會還活著？",
  "sources": [
    {
      "citation": "Pearl, J. (2009). Causality: Models, Reasoning, and Inference (2nd ed.), §7.1.2. Cambridge University Press.",
      "key": "pearl-2009",
      "verified": false
    }
  ],
  "model": {
    "variables": [
      { "id": "U", "label": { "zh": "法院下令", "en": "Court order" }, "kind": "exogenous", "domain": "boolean" },
      { "id": "C", "label": { "zh": "隊長發令", "en": "Captain signals" }, "kind": "endogenous", "domain": "boolean" },
      { "id": "A", "label": { "zh": "槍手 A 開槍", "en": "Rifleman A shoots" }, "kind": "endogenous", "domain": "boolean" },
      { "id": "B", "label": { "zh": "槍手 B 開槍", "en": "Rifleman B shoots" }, "kind": "endogenous", "domain": "boolean" },
      { "id": "D", "label": { "zh": "囚犯死亡", "en": "Prisoner dies" }, "kind": "endogenous", "domain": "boolean" }
    ],
    "equations": { "C": "U", "A": "C", "B": "C", "D": "A or B" }
  },
  "context": { "U": 1 },
  "priors": { "independent": { "U": 0.7 } },
  "verdicts": [
    { "theory": "counterfactual", "query": { "evidence": "D=1", "do": { "A": 0 }, "event": "D=1" }, "expected": 1, "note": "Abduction: D=1 ⇒ U=1 ⇒ B=1." },
    { "theory": "counterfactual", "query": { "evidence": "D=1", "do": { "C": 0 }, "event": "D=0" }, "expected": 1 },
    { "theory": "probability", "query": { "event": "D=1", "do": { "A": 0 } }, "expected": 0.7 },
    { "theory": "probability", "query": { "event": "D=1", "do": { "C": 0 } }, "expected": 0 },
    { "theory": "probability", "query": { "event": "D=1", "given": "A=0" }, "expected": 0, "note": "Seeing A=0 means no order was given." },
    { "theory": "butfor", "query": { "cause": "A=1", "effect": "D=1" }, "expected": "not-cause" },
    { "theory": "butfor", "query": { "cause": "C=1", "effect": "D=1" }, "expected": "cause" },
    { "theory": "hp-modified", "query": { "cause": "A=1", "effect": "D=1" }, "expected": "part-of-cause" },
    { "theory": "hp-modified", "query": { "cause": "C=1", "effect": "D=1" }, "expected": "cause" }
  ],
  "showcase": [
    { "label": { "zh": "A 沒開槍", "en": "A does not shoot" }, "interventions": { "A": 0 } },
    { "label": { "zh": "隊長沒發令", "en": "Captain gives no signal" }, "interventions": { "C": 0 } }
  ]
}
