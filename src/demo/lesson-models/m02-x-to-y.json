{
  "format": "causal-atlas/model",
  "version": 1,
  "title": "X → Y",
  "model": {
    "variables": [
      {
        "id": "U_X",
        "label": {
          "zh-TW": "X 的背景",
          "en": "Background of X"
        },
        "kind": "exogenous",
        "domain": "boolean"
      },
      {
        "id": "N1",
        "label": {
          "zh-TW": "X 成立時 Y 的雜訊",
          "en": "Y noise given X"
        },
        "kind": "exogenous",
        "domain": "boolean"
      },
      {
        "id": "N0",
        "label": {
          "zh-TW": "X 不成立時 Y 的雜訊",
          "en": "Y noise given not X"
        },
        "kind": "exogenous",
        "domain": "boolean"
      },
      {
        "id": "X",
        "label": {
          "zh-TW": "X",
          "en": "X"
        },
        "kind": "endogenous",
        "domain": "boolean"
      },
      {
        "id": "Y",
        "label": {
          "zh-TW": "Y",
          "en": "Y"
        },
        "kind": "endogenous",
        "domain": "boolean"
      }
    ],
    "equations": {
      "X": "U_X",
      "Y": "if X then N1 else N0"
    }
  },
  "priors": {
    "independent": {
      "U_X": 0.5,
      "N1": 0.8,
      "N0": 0.2
    }
  }
}
