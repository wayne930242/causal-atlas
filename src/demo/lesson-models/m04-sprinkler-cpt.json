          "en": "Grass wet with rain only"
        },
        "kind": "exogenous",
        "domain": "boolean"
      },
      {
        "id": "N_F1",
        "label": {
          "zh-TW": "草地濕時路滑",
          "en": "Slippery when the grass is wet"
        },
        "kind": "exogenous",
        "domain": "boolean"
      },
      {
        "id": "N_F0",
        "label": {
          "zh-TW": "草地乾時路滑",
          "en": "Slippery when the grass is dry"
        },
        "kind": "exogenous",
        "domain": "boolean"
      }
    ],
    "equations": {
      "C": "U_C",
      "R": "if C then N_R1 else N_R0",
      "W": "if S and R then N_W11 else if S then N_W10 else if R then N_W01 else false",
      "F": "if W then N_F1 else N_F0",
      "S": "if C then N_S1 else N_S0"
    }
  },
  "priors": {
    "independent": {
      "U_C": 0.5,
      "N_S1": 0.2,
      "N_S0": 0.6,
      "N_R1": 0.7,
