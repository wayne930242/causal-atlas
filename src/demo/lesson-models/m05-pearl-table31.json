  "priors": {
    "independent": {
      "U_X": 0.5,
      "N_Z1": 0.95,
      "N_Z0": 0.05,
      "N_Y00": 0.1,
      "N_Y10": 0.9,
      "N_Y01": 0.05,
      "N_Y11": 0.85
