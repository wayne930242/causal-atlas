        "domain": "boolean"
      },
      {
        "id": "N_Z0",
        "label": {
          "zh-TW": "不吸菸者積焦油",
          "en": "Non-smokers build tar"
        },
        "kind": "exogenous",
        "domain": "boolean"
      },
      {
        "id": "N_Y00",
        "label": {
          "zh-TW": "不吸菸、無焦油者得癌",
          "en": "X=0, Z=0: cancer"
