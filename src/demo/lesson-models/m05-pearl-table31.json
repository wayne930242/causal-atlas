      },
      {
        "id": "N_Y11",
        "label": {
          "zh-TW": "吸菸、有焦油者得癌",
          "en": "X=1, Z=1: cancer"
        },
        "kind": "exogenous",
        "domain": "boolean"
      },
      {
        "id": "X",
        "label": {
          "zh-TW": "吸菸",
          "en": "Smokes"
        },
        "kind": "endogenous",
        "domain": "boolean"
      },
      {
        "id": "Z",
        "label": {
          "zh-TW": "肺部焦油",
          "en": "Tar in lungs"
        },
        "kind": "endogenous",
        "domain": "boolean"
      },
      {
